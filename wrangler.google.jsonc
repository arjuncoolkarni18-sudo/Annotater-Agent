{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "annotater-agent",
  "main": "standalone/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-google",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini",
    "DAILY_AI_LIMIT": "25"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "margin-google",
      "migrations_dir": "standalone/migrations"
    }
  ]
}
